min-release-age=7

# The editor stack (@atlaskit/renderer + editor-common, see
# spec/016-report-of-reports/007-latest-comment-report) pushes vite and storybook past Node's
# default heap (4288 MB here) and they abort with "Ineffective mark-compacts near heap limit".
# 6144 was verified sufficient; this leaves headroom. Set here rather than as a NODE_OPTIONS prefix
# on each build script so it needs no shell-specific syntax and covers storybook dev too.
node-options=--max-old-space-size=8192
